<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0E0F0D"
    android:orientation="vertical"
    android:paddingStart="3dp"
    android:paddingEnd="3dp"
    android:paddingTop="4dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingBottom="2dp"
        android:text="GrokBoard"
        android:textColor="#A8B5AE"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_grok"
            android:layout_width="52dp"
            android:layout_height="46dp"
            android:layout_margin="2dp"
            android:background="@drawable/key_bg"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="✦"
            android:textAllCaps="false"
            android:textColor="#F4F1EA"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btn_actions"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_margin="2dp"
            android:background="@drawable/act_bg"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="Ações"
            android:textAllCaps="false"
            android:textColor="#F4F1EA"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_emoji"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_margin="2dp"
            android:background="@drawable/key_bg"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="☺"
            android:textColor="#F4F1EA"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_clip"
            android:layout_width="52dp"
            android:layout_height="46dp"
            android:layout_margin="2dp"
            android:background="@drawable/key_bg"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="Colar"
            android:textAllCaps="false"
            android:textColor="#F4F1EA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/persona_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:paddingEnd="8dp"
            android:text="Direto"
            android:textColor="#F4F1EA"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_margin="2dp"
            android:background="@drawable/key_bg"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="⚙"
            android:textColor="#F4F1EA"
            android:textSize="16sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/sheet_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp" />
    </ScrollView>

    <HorizontalScrollView
        android:id="@+id/accent_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/accent_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/board"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
