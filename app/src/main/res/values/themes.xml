<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GrokBoard" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">#0E0F0D</item>
        <item name="android:navigationBarColor">#0E0F0D</item>
    </style>
    <style name="Key">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:textColor">#F4F1EA</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/key_bg</item>
    </style>
    <style name="Act">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#F4F1EA</item>
        <item name="android:background">@drawable/act_bg</item>
    </style>
</resources>
